# Build output, both sides.
build/
client_wear/build/

# Dart/Flutter caches.
.dart_tool/
.packages
.flutter-plugins
.flutter-plugins-dependencies

# Portable toolchain: llvm-mingw is ~900 MB and fetched, not authored.
tools/

# Reference checkout of the upstream harness, pinned for reading only.
third_party/

# Scratch data from session-log repair work.
_dsh-repair/

# Local secrets. config.json and server.conf both carry the relay passphrase
# and the dsh launch token in clear text, so neither belongs in a repository.
config.json
server.conf
*.dsh-token
.env
.env.*

# One-shot release helper, not part of the project.
_publish.*

# Editor and OS noise.
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
_sync.mjs
frameprobe.log
